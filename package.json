{
  "name": "codex-workflow-next",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "doctor": "node ./scripts/doctor.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "benchmark:ph03": "npm run build && node ./benchmarks/ph03-query-strategies.mjs",
    "prevalidate:plugin": "npm run build",
    "validate:plugin": "node ./scripts/validate-plugin.mjs",
    "check": "npm run typecheck && npm test && npm run lint && npm run validate:plugin"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
